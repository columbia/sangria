  "sanity_check": {
    "pipelined_uses_resolver": true,
    "traditional_no_resolver": true,
    "pipelined_faster_than_traditional": true,
    "throughput_ratio_at_0_abort": 4.0,
    "latency_ratio_at_0_abort": 4.15
  },
  "key_observations": [
    "Pipelined 2PC is ~4x faster than Traditional at 0% abort rate due to early lock release",
    "Pipelined resolver tracks dependency groups (348 size-1, 68 size-2, 5 size-3 at 0% abort)",
    "Traditional has no resolver activity - locks prevent concurrent access",
    "Both systems handle 30% abort rate with similar completion ratios (~72-76%)",
    "Pipelined latency is ~4x lower (77ms vs 310ms at p50)"
  ]
