    {
      "baseline": "Traditional",
      "abort_rate": 0.0,
      "throughput": 63.29,
      "total_transactions": 500,
      "avg_latency_ms": 309.92,
      "p50_latency_ms": 310.47,
      "p95_latency_ms": 340.80,
